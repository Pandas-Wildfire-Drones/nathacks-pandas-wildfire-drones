<?xml version="1.0" ?>
<!--
  PX4 Autonomous Wildfire & Obstacle Avoidance Gazebo World
  Compatible with: Gazebo Classic (gazebo) and Gazebo Garden/Harmonic (gz sim)
  Coordinates: Standard ENU / Gazebo frame (X=East, Y=North, Z=Up)
-->
<sdf version="1.6">
  <world name="wildfire_obstacle_world">
    
    <!-- Physics parameters calibrated for PX4 flight control -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Sun & Ambient Sky Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane (Terrain) -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Scene fog to simulate forest / smoke atmosphere -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.15 0.2 0.25 1.0</background>
      <shadows>true</shadows>
      <fog>
        <color>0.2 0.25 0.3 1</color>
        <type>exp</type>
        <density>0.006</density>
      </fog>
    </scene>


    <!-- ==================== DENSE FOREST OBSTACLES ==================== -->
    <!-- Tree Obstacle 1 -->
    <model name="pine_tree_1">
      <static>true</static>
      <pose>5 -15 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>14.0</length></cylinder></geometry>
          <pose>0 0 7.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>14.0</length></cylinder></geometry>
          <pose>0 0 7.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <collision name="collision">
          <geometry><cone><radius>2.2</radius><length>10.0</length></cone></geometry>
          <pose>0 0 9.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cone><radius>2.2</radius><length>10.0</length></cone></geometry>
          <pose>0 0 9.0 0 0 0</pose>
          <material><ambient>0.08 0.35 0.15 1</ambient><diffuse>0.1 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 2 -->
    <model name="pine_tree_2">
      <static>true</static>
      <pose>-8 -18 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>16.0</length></cylinder></geometry>
          <pose>0 0 8.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>16.0</length></cylinder></geometry>
          <pose>0 0 8.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <collision name="collision">
          <geometry><cone><radius>2.4</radius><length>11.0</length></cone></geometry>
          <pose>0 0 10.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cone><radius>2.4</radius><length>11.0</length></cone></geometry>
          <pose>0 0 10.5 0 0 0</pose>
          <material><ambient>0.08 0.35 0.15 1</ambient><diffuse>0.1 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 3 -->
    <model name="pine_tree_3">
      <static>true</static>
      <pose>12 -28 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>13.0</length></cylinder></geometry>
          <pose>0 0 6.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>13.0</length></cylinder></geometry>
          <pose>0 0 6.5 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 4 (Close Obstacle) -->
    <model name="pine_tree_4">
      <static>true</static>
      <pose>-4 -32 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>18.0</length></cylinder></geometry>
          <pose>0 0 9.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>18.0</length></cylinder></geometry>
          <pose>0 0 9.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 5 -->
    <model name="pine_tree_5">
      <static>true</static>
      <pose>2 -45 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>15.0</length></cylinder></geometry>
          <pose>0 0 7.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>15.0</length></cylinder></geometry>
          <pose>0 0 7.5 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wildfire Target Beacon Alpha (Coordinate: North=48, East=8) -->
    <model name="wildfire_target_alpha">
      <static>true</static>
      <pose>8 -48 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>3.5</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>3.5</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.05 1</ambient>
            <diffuse>1.0 0.25 0.05 1</diffuse>
            <emissive>0.8 0.2 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wildfire Target Beacon Bravo (Coordinate: North=75, East=-8) -->
    <model name="wildfire_target_bravo">
      <static>true</static>
      <pose>-8 -75 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>4.0</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>4.0</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.05 1</ambient>
            <diffuse>1.0 0.25 0.05 1</diffuse>
            <emissive>0.8 0.2 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
