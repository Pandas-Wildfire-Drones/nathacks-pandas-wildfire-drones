<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="wildfire_obstacle_world">
    
    <!-- Physics parameters calibrated for PX4 in modern Gazebo (gz) -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- Required Gazebo Sim (gz) system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Self-contained Directional Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Self-contained Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 600</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 600</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.3 0.25 1</ambient>
            <diffuse>0.3 0.38 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== PINE TREE OBSTACLES ==================== -->
    <!-- Tree Obstacle 1 (North=15, East=5) -->
    <model name="pine_tree_1">
      <static>true</static>
      <pose>5 -15 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>14.0</length></cylinder></geometry>
          <pose>0 0 7.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>14.0</length></cylinder></geometry>
          <pose>0 0 7.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <collision name="collision">
          <geometry><cone><radius>2.2</radius><length>10.0</length></cone></geometry>
          <pose>0 0 9.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cone><radius>2.2</radius><length>10.0</length></cone></geometry>
          <pose>0 0 9.0 0 0 0</pose>
          <material><ambient>0.08 0.35 0.15 1</ambient><diffuse>0.1 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 2 (North=18, East=-8) -->
    <model name="pine_tree_2">
      <static>true</static>
      <pose>-8 -18 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>16.0</length></cylinder></geometry>
          <pose>0 0 8.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>16.0</length></cylinder></geometry>
          <pose>0 0 8.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <collision name="collision">
          <geometry><cone><radius>2.4</radius><length>11.0</length></cone></geometry>
          <pose>0 0 10.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cone><radius>2.4</radius><length>11.0</length></cone></geometry>
          <pose>0 0 10.5 0 0 0</pose>
          <material><ambient>0.08 0.35 0.15 1</ambient><diffuse>0.1 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 3 (North=28, East=12) -->
    <model name="pine_tree_3">
      <static>true</static>
      <pose>12 -28 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>13.0</length></cylinder></geometry>
          <pose>0 0 6.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>13.0</length></cylinder></geometry>
          <pose>0 0 6.5 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 4 (North=32, East=-4) -->
    <model name="pine_tree_4">
      <static>true</static>
      <pose>-4 -32 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>18.0</length></cylinder></geometry>
          <pose>0 0 9.0 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>18.0</length></cylinder></geometry>
          <pose>0 0 9.0 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree Obstacle 5 (North=45, East=2) -->
    <model name="pine_tree_5">
      <static>true</static>
      <pose>2 -45 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>15.0</length></cylinder></geometry>
          <pose>0 0 7.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>15.0</length></cylinder></geometry>
          <pose>0 0 7.5 0 0 0</pose>
          <material><ambient>0.25 0.15 0.1 1</ambient><diffuse>0.3 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wildfire Target Beacon Alpha (Coordinate: North=48, East=8) -->
    <model name="wildfire_target_alpha">
      <static>true</static>
      <pose>8 -48 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>3.5</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>3.5</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.05 1</ambient>
            <diffuse>1.0 0.25 0.05 1</diffuse>
            <emissive>0.8 0.2 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wildfire Target Beacon Bravo (Coordinate: North=75, East=-8) -->
    <model name="wildfire_target_bravo">
      <static>true</static>
      <pose>-8 -75 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>4.0</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>4.0</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.05 1</ambient>
            <diffuse>1.0 0.25 0.05 1</diffuse>
            <emissive>0.8 0.2 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>